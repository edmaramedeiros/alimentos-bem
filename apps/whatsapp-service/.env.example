# Copie para .env e preencha. Usado a partir do Marco 7 (WhatsApp).

PORT=3001

# Mesma base Postgres do backend - usada para a fila de broadcast e a
# sessão do Baileys persistida (whatsapp_session), ver docs/decisions.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edmara_alimentos

# Deve ser igual a WHATSAPP_SERVICE_API_KEY no backend/.env
INTERNAL_API_KEY=troque-por-uma-chave-compartilhada
