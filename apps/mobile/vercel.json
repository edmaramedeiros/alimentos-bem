{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/sistema/products/new", "destination": "/sistema/products/new.html" },
    { "source": "/sistema/customers/new", "destination": "/sistema/customers/new.html" },
    { "source": "/sistema/sales/new", "destination": "/sistema/sales/new.html" },
    { "source": "/sistema/users/new", "destination": "/sistema/users/new.html" },
    { "source": "/sistema/whatsapp/new", "destination": "/sistema/whatsapp/new.html" },
    { "source": "/sistema/expenses/new", "destination": "/sistema/expenses/new.html" },
    { "source": "/sistema/products/:id", "destination": "/sistema/products/[id].html" },
    { "source": "/sistema/customers/:id", "destination": "/sistema/customers/[id].html" },
    { "source": "/sistema/sales/:id", "destination": "/sistema/sales/[id].html" },
    { "source": "/sistema/users/:id", "destination": "/sistema/users/[id].html" },
    { "source": "/sistema/whatsapp/:id", "destination": "/sistema/whatsapp/[id].html" }
  ]
}
